#!/bin/sh
# 提交前门禁 —— 薄壳：真实现在 scripts/verify-all.mjs（钩子与 CI 共用同一处，避免两套清单漂移）
# 变更：2026-10-06 之前这里手写串联 7 个门禁，CI 又另有一套 ✗ → 收敛为一条命令 + 索引见 scripts/README.md
# ⚠ 历史坑（保留提醒）：sh 里变量紧邻中文/全角字符时（`…$log）`）会把多字节字符首字节并进变量名 →
#   报 `$log<乱码>: unbound variable`，且只在失败分支触发。变量紧邻非 ASCII 时一律写 ${log}。
# 安装（文件在仓库里，但 git 不会自动启用）：
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -u

# node 可能不在默认 PATH（本机装在 .workbuddy 下）；找不到就跳过，别挡提交。
command -v node >/dev/null 2>&1 || export PATH="/Users/liujiachen/.workbuddy/binaries/node/versions/22.12.0/bin:$PATH"
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 未找到 node，跳过门禁"; exit 0
fi

root="$(git rev-parse --show-toplevel)" && cd "$root" || exit 1

if ! node scripts/verify-all.mjs; then
  echo "pre-commit: 门禁未通过 → 已阻止提交（确认无误可用 git commit --no-verify 跳过）"
  exit 1
fi
